APP_NAME="Ujian Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DEPLOY KE VPS / PRODUCTION — ubah nilai berikut:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://domain-anda.com
#   APP_KEY=           (generate dengan: php artisan key:generate)
#   DB: pakai MySQL — isi DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD
#   REVERB: set domain + https (lihat komentar di bawah)
#   Jalankan php artisan storage:link supaya gambar soal bisa tampil
# ============================================================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ujian_online
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ---- Realtime (Reverb) — dipakai app, wajib diisi di VPS ----
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=reverb-app-id
REVERB_APP_KEY=reverb-app-key
REVERB_APP_SECRET=reverb-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Di VPS (HTTPS + domain):
#   REVERB_HOST=domain-anda.com
#   REVERB_PORT=443
#   REVERB_SCHEME=https
# Jalankan server: php artisan reverb:start  (via supervisor / systemd)

FILESYSTEM_DISK=public
# Wajib di VPS: php artisan storage:link

QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# TinyMCE (editor soal) — daftar gratis di https://www.tiny.cloud untuk dapat key
API_KEY_TINYMCE=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
